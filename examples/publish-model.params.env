# Example values for "MaaS 1 - Publish a model".
# The OpenShift console form is the normal way to fill these in.
# CLI:
#   oc process --local -f templates/maas-publish-model-template.yaml \
#     --param-file examples/publish-model.params.env | oc apply -f -

MODEL_NAME=qwen3-8b-fp8-dynamic
MODEL_NAMESPACE=demo-llm
MODEL_KIND=LLMInferenceService
MODEL_DISPLAY_NAME=Qwen3 8B FP8
MODEL_DESCRIPTION=General-purpose chat model, FP8 dynamic quantization
TENANT_NAME=models-as-a-service
