# Example values for "MaaS 2 - Model subscription and pricing".
# The OpenShift console form is the normal way to fill these in.
# For a CLI run instead:
#   oc process --local -f templates/maas-model-subscription-pricing-template.yaml \
#     --param-file examples/subscription-pricing.params.env | oc apply -f -

# Model (must already be published: MaaS 1 template or the OpenShift AI dashboard)
MODEL_NAME=qwen3-8b-fp8-dynamic
MODEL_NAMESPACE=demo-llm
METRICS_MODEL_NAME=qwen3-8b-fp8-dynamic

# Tenant
TENANT_NAMESPACE=models-as-a-service

# Subscription (one tier)
SUBSCRIPTION_NAME=premium-qwen3-8b
SUBSCRIPTION_DISPLAY_NAME=Premium - Qwen3 8B
SUBSCRIPTION_DESCRIPTION=20k tokens/min, 400k tokens/hour, 4M tokens/day
GROUP=premium-users
TOKENS_PER_MINUTE=20000
TOKENS_PER_HOUR=400000
TOKENS_PER_DAY=4000000
PRIORITY=50

# Cost attribution
ORGANIZATION_ID=acme
COST_CENTER=cc-acme

# Pricing (per 1M tokens, prompt + completion)
PRICE_PER_MILLION_TOKENS=200
CURRENCY=USc
MONITORING_NAMESPACE=redhat-ods-monitoring
